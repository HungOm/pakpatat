# ---------------------------------------------------------------------------
# SECRETS -- first, and non-negotiable.
# .env holds provider API keys. It is written by the in-app Settings panel and
# must never reach a commit, a fork, or a pull request.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem

# ---------------------------------------------------------------------------
# ARCHIVE CONTENT -- deliberately not distributed.
# The source material this assistant reads is UNHCR's copyrighted work (see the
# README's Notices section). This repository ships the code that builds and searches an
# archive, never the archive itself. Everything under data/ is generated on
# the user's own machine from their own copy of the source material.
# ---------------------------------------------------------------------------
data/
*.jsonl
*.jsonl.bak

# Generated search index (rebuild with: python build_index.py)
.index/
*.npy

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Local eval runs. eval/baseline.json IS tracked -- it is the reference the
# regression gate compares against, so it belongs in review like any contract.
# ---------------------------------------------------------------------------
eval/*.json
!eval/baseline.json

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Generated by packaging/version_info.py from __version__ -- never edited by hand.
packaging/version_info.txt
dist/
build/
*.spec.bak
